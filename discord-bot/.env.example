DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
VERIFIED_ROLE_ID=

# backend/.env 와 동일한 값이어야 한다
# docker compose로 띄울 경우 서비스명을 써야 한다: http://backend:8000
BACKEND_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-to-a-random-string

# /인증 실행 시 보여줄 서버 규칙 (줄바꿈은 \n)
SERVER_RULES=1. 서버 규칙을 지켜주세요.\n2. 타인을 존중해주세요.\n3. 광고/스팸 금지.
