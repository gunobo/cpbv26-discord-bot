DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
VERIFIED_ROLE_ID=

# 서버에 이미 있는 규칙 메시지. /인증 실행 시 이 메시지에 RULES_EMOJI로
# 반응(체크)했는지만 확인한다. 채널/메시지 ID는 디스코드 개발자모드 켜고
# 메시지 우클릭 → ID 복사로 얻는다.
RULES_CHANNEL_ID=
RULES_MESSAGE_ID=
RULES_EMOJI=✅

# backend/.env 와 동일한 값이어야 한다
# docker compose로 띄울 경우 서비스명을 써야 한다: http://backend:8000
BACKEND_URL=http://localhost:8000
INTERNAL_API_KEY=change-me-to-a-random-string
