# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
VERIFIED_ROLE_ID=

# Web
WEB_BASE_URL=http://localhost:8000
PORT=8000
COOKIE_SECRET=change-me-to-a-random-string

# Internal API (must match discord-bot/.env's INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me-to-a-random-string

# Hive
# Hive 콘솔 키가 없는 동안은 true로 두면 실제 Hive 호출 없이 전체 플로우를 테스트할 수 있다.
HIVE_MOCK_MODE=true
HIVE_ENV=sandbox
HIVE_APPID=
HIVE_GINDEX=
HIVE_CERTIFICATION_KEY=
HIVE_REDIRECT_URL=http://localhost:8000/verify/callback

# DB
DATABASE_URL=sqlite:///./app.db

# 인증된 유저의 팀/오버롤을 게임 데이터 API에서 다시 조회해 갱신하는 주기(초).
# 실제 게임 데이터 API가 연결되기 전까지는 값이 안 바뀌어서 사실상 아무 일도
# 안 하지만, 나중에 API가 연결되면 바로 동작한다.
STATS_REFRESH_INTERVAL_SECONDS=300

# /쿠폰목록이 매번 커뮤니티 사이트를 긁지 않도록, 이 주기(초)마다 백그라운드에서
# 미리 가져와 캐싱해둔다.
COUPON_REFRESH_INTERVAL_SECONDS=600
