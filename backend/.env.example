# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
VERIFIED_ROLE_ID=

# Web
WEB_BASE_URL=http://localhost:8000
PORT=8000
COOKIE_SECRET=change-me-to-a-random-string

# Internal API (must match discord-bot/.env's INTERNAL_API_KEY)
INTERNAL_API_KEY=change-me-to-a-random-string

# Hive
# Hive 콘솔 키가 없는 동안은 true로 두면 실제 Hive 호출 없이 전체 플로우를 테스트할 수 있다.
HIVE_MOCK_MODE=true
HIVE_ENV=sandbox
HIVE_APPID=
HIVE_GINDEX=
HIVE_CERTIFICATION_KEY=
HIVE_REDIRECT_URL=http://localhost:8000/verify/callback

# DB
DATABASE_URL=sqlite:///./app.db
